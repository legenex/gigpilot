NODE_ENV=production
LOG_LEVEL=info
WEB_URL=https://gigpilot.ai
APP_URL=https://app.gigpilot.ai
CANONICAL_WEB_URL=https://gigpilot.ai
CANONICAL_APP_URL=https://app.gigpilot.ai
# Share the session cookie between gigpilot.ai and app.gigpilot.ai
AUTH_COOKIE_DOMAIN=gigpilot.ai
AUTH_TRUSTED_ORIGINS=https://www.gigpilot.ai
# Public deployment: restrict sign-up until billing/onboarding exist
SIGNUP_MODE=invite
AUTH_ALLOWED_EMAILS=@legenex.com
DEMO_SEED_ON_SIGNUP=false
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=gigpilot-assets
S3_REGION=auto
GX_BASE_URL=           # optional: GX over Tailscale if the VPS joins the tailnet
PAID_PROVIDER_DAILY_BUDGET_USD=0
