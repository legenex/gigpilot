[Unit]
Description=GigPilot Tailscale proxy for port %i (docker stays on loopback; boot-safe)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/gigpilot/bin/ts-proxy.sh %i
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
