/data/
/storage/
/var/
*.dump
*.sql.gz

# test output
test-results/
playwright-report/
blob-report/
coverage/
e2e/.auth/
e2e/screenshots/

# logs & os
*.log
npm-debug.log*
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# claude code local runtime
.claude/*.lock
.claude/settings.local.json
