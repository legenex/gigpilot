# dependencies
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# env & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/
ops/gx10-01/.env
ops/gx10-01/*.env
