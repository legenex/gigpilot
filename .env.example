# GigPilot environment. Copy to .env (local dev) or /srv/projects/gigpilot/config/gigpilot.env (gx10-01).
# Never commit real values. Secrets marked [secret].

DATABASE_URL=postgres://gigpilot:CHANGE_ME@127.0.0.1:4715/gigpilot_dev

# Public origins (local Tailscale on gx10-01 shown; production uses the canonical domains)
WEB_URL=http://100.105.214.61:4710
APP_URL=http://100.105.214.61:4711
CANONICAL_WEB_URL=https://gigpilot.ai
CANONICAL_APP_URL=https://app.gigpilot.ai
# Production only: share the session across gigpilot.ai and app.gigpilot.ai
# AUTH_COOKIE_DOMAIN=gigpilot.ai
AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=            # [secret] openssl rand -base64 48
SIGNUP_MODE=open               # open | invite
AUTH_ALLOWED_EMAILS=           # invite mode: comma list, "@domain.com" entries allowed
DEMO_SEED_ON_SIGNUP=true
# Workspaces whose owner/admin email is listed may use the server-wide provider
# credentials below; every other workspace must store its own (Integrations).
OPERATOR_EMAILS=
TENANT_MAX_DAILY_PAID_USD=0    # paid ceiling for non-operator workspaces
AUTH_REQUIRE_EMAIL_VERIFICATION=false   # needed for @domain invite entries (requires an email sender)

GIGPILOT_ENCRYPTION_KEY=       # [secret] openssl rand -base64 32
AGENTOS_SUPERVISION_TOKEN=     # [secret] bearer for /api/supervision/*
# Inbound marketplace-notification webhooks use a per-workspace secret generated in
# Integrations (signature over "<ts>.<workspace-slug>.<provider>.<body>").

STORAGE_DRIVER=filesystem      # filesystem | s3
STORAGE_ROOT=./var/storage
WORKER_HEALTH_PORT=4722
WORKER_SCHEDULES_ENABLED=true

# Real-money guardrail: paid providers are never called while this is 0.
PAID_PROVIDER_DAILY_BUDGET_USD=0

# Intelligence
GX_BASE_URL=http://127.0.0.1:4000/v1   # containers: http://gx-litellm:4000/v1
GX_API_KEY=                    # [secret] LiteLLM virtual key (alias gigpilot)
GX_CODE_MAX_CONCURRENCY=1      # share of gx-code (2 slots cluster-wide, shared)
FACTORY_ALLOW_IN_PROCESS=false # droid needs an isolated sandbox runner
FACTORY_API_KEY=               # [secret] fk-...
FACTORY_DROID_BIN=droid
FACTORY_MODEL=auto             # Factory Router
XAI_API_KEY=                   # [secret]
XAI_MODEL=grok-4.3

# Creative
KIE_API_KEY=                   # [secret]
KIE_WEBHOOK_HMAC_KEY=          # [secret]
HIGGSFIELD_API_KEY=            # [secret] key id
HIGGSFIELD_API_SECRET=         # [secret] key secret

# Marketplaces
UPWORK_CLIENT_ID=              # [secret]
UPWORK_CLIENT_SECRET=          # [secret]
FREELANCER_OAUTH_TOKEN=        # [secret]
FREELANCER_BASE_URL=https://www.freelancer.com/api   # sandbox: https://www.freelancer-sandbox.com/api
